#!/bin/bash

VERSION="1.2"
VOLUME_NAME=$1
SUBPATH=$2

# check if a flag was passed as its own argument
has_flag() {
    local flag=$1 arg
    shift
    for arg in "$@"; do
        [ "$arg" == "$flag" ] && return 0
    done
    return 1
}

# download a file to a temp file, verify that it contains $pattern and move it into place
download_file() {
    local url=$1 dest=$2 mode=$3 pattern=$4 tmp_file
    tmp_file=$(mktemp) || return 1
    if curl -fsS -o "$tmp_file" "$url" && grep -q "$pattern" "$tmp_file" && mv "$tmp_file" "$dest"; then
        chmod "$mode" "$dest"
        return 0
    fi
    rm -f "$tmp_file"
    return 1
}

# Function to check for updates and update the script
check_for_updates() {
    local url="https://raw.githubusercontent.com/fsteltenkamp/DockerScripts/main/dvls"
    local version_url="https://raw.githubusercontent.com/fsteltenkamp/DockerScripts/main/dvls.ver"
    local REMOTE_VERSION

    # Check if the content of $version_url is different to our $VERSION var:
    if ! REMOTE_VERSION=$(curl -fsS "$version_url"); then
        echo "Error: Could not check for updates."
        return 1
    fi
    if [ "$REMOTE_VERSION" != "$VERSION" ]; then
        echo "A new version of the script is available. Updating..."
        if ! download_file "$url" "$0" 755 '^#!/bin/bash'; then
            echo "Error: Update failed, the script was not changed."
            return 1
        fi
        echo "Update complete. Please re-run the script. (arrow-up + enter)"
        exit 0
    fi
    echo "Already up to date."
}

usage() {
    echo "Usage: $0 <volume_name> [subpath]"
    echo "Example: $0 myvolume"
}

check_arguments() {
    if [ -z "$VOLUME_NAME" ]; then
        echo "Error: Missing arguments"
        usage
        exit 1
    fi
}

# check if docker volume exists (return 0 if it does)
check_volume() {
    docker volume inspect "$VOLUME_NAME" &> /dev/null
}

list_volume_contents() {
    docker run --rm -v "$VOLUME_NAME:/volume" alpine ls --color=auto -hAl --group-directories-first "/volume/$SUBPATH"
}

install_other_scripts() {
    local base_url="https://raw.githubusercontent.com/fsteltenkamp/DockerScripts/main"
    local script
    # request permission:
    echo "This action will install several more scripts on this system to aid in handling docker volumes."
    echo "The Scripts will be installed in /usr/local/bin."
    echo "Do you want to continue? (y/n)"
    read -r answer
    # only continue if user gives permission:
    if [ "$answer" == "y" ]; then
        if [ ! -w /usr/local/bin ]; then
            echo "Error: No write permission for /usr/local/bin, try again with sudo."
            exit 1
        fi
        # download the scripts (into a temp file first, this script might be one of them and is still running):
        for script in dvbr dvls dvfbr dvsh dvsmbcr; do
            download_file "$base_url/$script" "/usr/local/bin/$script" 755 '^#!/bin/bash' || echo "Error: Could not install $script"
        done
        # install bash completion (volume names, paths inside volumes, backups, ...):
        mkdir -p /etc/bash_completion.d
        download_file "$base_url/dockerscripts-completion.bash" /etc/bash_completion.d/dockerscripts 644 '^complete -F' || echo "Error: Could not install bash completion"
        echo "Scripts installed. You can now use the following scripts:"
        echo "- dvbr.....backup and restore Docker Volumes."
        echo "- dvls.....list files inside a Docker Volume."
        echo "- dvfbr....start a filebrowser to manage files in a Docker Volume."
        echo "- dvsh.....start a shell inside a Docker Volume."
        echo "- dvsmbcr..easily create a new Volume that is connected to a SMB Share."
        echo "Tab-completion is enabled in new shells (requires the bash-completion package)."
    fi
}

# MAIN
# check if the user wants to install the other scripts:
if has_flag --install "$@"; then
    install_other_scripts
    exit
fi
# check if the user wants to update the script:
if has_flag --update "$@"; then
    check_for_updates
    exit
fi
check_arguments
if check_volume; then
    list_volume_contents
else
    echo "Error: Volume '$VOLUME_NAME' does not exist"
    exit 1
fi
