#!/bin/bash

# Vars
VERSION="1.3.1"
STORAGE="/srv/dvbr"
# Inputs
mode=$1
volume=$2
path=$3

# Display usage and help information
usage() {
    echo "Usage: $0 <mode> <volume> [path]"
    echo ""
    echo "Modes:"
    echo "  backup:  Backup the contents of a Docker volume."
    echo "  restore: Restore the contents of a Docker volume from a backup."
    echo "   ----------------------------------------------   "
    echo "Parameters:"
    echo "  mode:         see Section Modes"
    echo "  volume:       Name of the docker volume to backup or restore."
    echo "  path:         The Path to the file to be restored. - Only used in restore mode."
    echo "   ----------------------------------------------   "
    echo "Examples:"
    echo "  $0 backup my_volume  -> Creates a .tar.gz file in $STORAGE/my_volume with the contents of the volume my_volume."
    echo "  $0 restore my_volume $STORAGE/my_volume/backup-20210101-120000.tar.gz -> Replaces the contents of the volume my_volume with the contents of the file."
}

check_docker() {
    if ! command -v docker &> /dev/null; then
        echo "Error: Docker is not installed."
        exit 1
    fi
}

# check if a flag was passed as its own argument
has_flag() {
    local flag=$1 arg
    shift
    for arg in "$@"; do
        [ "$arg" == "$flag" ] && return 0
    done
    return 1
}

# download a file to a temp file, verify that it contains $pattern and move it into place
download_file() {
    local url=$1 dest=$2 mode=$3 pattern=$4 tmp_file
    tmp_file=$(mktemp) || return 1
    if curl -fsS -o "$tmp_file" "$url" && grep -q "$pattern" "$tmp_file" && mv "$tmp_file" "$dest"; then
        chmod "$mode" "$dest"
        return 0
    fi
    rm -f "$tmp_file"
    return 1
}

# Function to check for updates and update the script
check_for_updates() {
    local url="https://raw.githubusercontent.com/fsteltenkamp/DockerScripts/main/dvbr"
    local version_url="https://raw.githubusercontent.com/fsteltenkamp/DockerScripts/main/dvbr.ver"
    local REMOTE_VERSION

    # Check if the content of $version_url is different to our $VERSION var:
    if ! REMOTE_VERSION=$(curl -fsS "$version_url"); then
        echo "Error: Could not check for updates."
        return 1
    fi
    if [ "$REMOTE_VERSION" != "$VERSION" ]; then
        echo "A new version of the script is available. Updating..."
        if ! download_file "$url" "$0" 755 '^#!/bin/bash'; then
            echo "Error: Update failed, the script was not changed."
            return 1
        fi
        echo "Update complete. Please re-run the script. (arrow-up + enter)"
        exit 0
    fi
    echo "Already up to date."
}

# check storage location, create it if it does not exist
check_storage() {
    if [ ! -d "$STORAGE" ]; then
        echo "Info: Storage path $STORAGE does not exist, creating it..."
        if ! mkdir -p "$STORAGE"; then
            echo "Error: Could not create storage path $STORAGE"
            exit 1
        fi
    fi
}

# check argument count
check_arguments() {
    if [ "$mode" == "backup" ] || [ "$mode" == "restore" ]; then
        if [ -z "$volume" ]; then
            echo "Error: Volume name must be provided for backup or restore mode"
            usage
            exit 1
        fi
        if [ "$mode" == "restore" ] && [ -z "$path" ]; then
            echo "Error: Path must be provided in restore mode"
            usage
            exit 1
        fi
    else
        echo "Error: Invalid mode"
        usage
        exit 1
    fi
}

check_volume() {
    if ! docker volume inspect "$volume" &> /dev/null; then
        echo "Error: Volume '$volume' does not exist"
        exit 1
    fi
}

install_other_scripts() {
    local base_url="https://raw.githubusercontent.com/fsteltenkamp/DockerScripts/main"
    local script
    # request permission:
    echo "This action will install several more scripts on this system to aid in handling docker volumes."
    echo "The Scripts will be installed in /usr/local/bin."
    echo "Do you want to continue? (y/n)"
    read -r answer
    # only continue if user gives permission:
    if [ "$answer" == "y" ]; then
        if [ ! -w /usr/local/bin ]; then
            echo "Error: No write permission for /usr/local/bin, try again with sudo."
            exit 1
        fi
        # download the scripts (into a temp file first, this script might be one of them and is still running):
        for script in dvbr dvls dvfbr dvsh dvsmbcr; do
            download_file "$base_url/$script" "/usr/local/bin/$script" 755 '^#!/bin/bash' || echo "Error: Could not install $script"
        done
        # install bash completion (volume names, paths inside volumes, backups, ...):
        mkdir -p /etc/bash_completion.d
        download_file "$base_url/dockerscripts-completion.bash" /etc/bash_completion.d/dockerscripts 644 '^complete -F' || echo "Error: Could not install bash completion"
        echo "Scripts installed. You can now use the following scripts:"
        echo "- dvbr.....backup and restore Docker Volumes."
        echo "- dvls.....list files inside a Docker Volume."
        echo "- dvfbr....start a filebrowser to manage files in a Docker Volume."
        echo "- dvsh.....start a shell inside a Docker Volume."
        echo "- dvsmbcr..easily create a new Volume that is connected to a SMB Share."
        echo "Tab-completion is enabled in new shells (requires the bash-completion package)."
    fi
}

# MAIN
# check if the user wants to install the other scripts:
if has_flag --install "$@"; then
    install_other_scripts
    exit
fi
# check if the user wants to update the script:
if has_flag --update "$@"; then
    check_for_updates
    exit
fi
check_docker
check_arguments
check_volume

# If mode is 'backup':
if [ "$mode" == "backup" ]; then
    check_storage
    # check directories:
    finalpath="$STORAGE/$volume"
    mkdir -p "$finalpath"
    echo "Starting backup for Volume $volume..."
    # backup volume
    if ! docker run --rm --mount "source=$volume,target=/mnt/backmeup" -v "$finalpath:/mnt/backups" busybox sh -c "cd /mnt/backmeup && tar czf /mnt/backups/backup-$(date +'%Y%m%d-%H%M%S').tar.gz ."; then
        echo "Error: Backup failed."
        exit 1
    fi
    echo "Backup done."
fi

# If mode is 'restore', check if path is provided and valid
if [ "$mode" == "restore" ]; then
    # Check if the file has a .tar.gz extension
    if [[ ! "$path" =~ \.tar\.gz$ ]]; then
        echo "Error: Path must be a valid .tar.gz file"
        exit 1
    fi

    # Check if the file exists
    if [ ! -f "$path" ]; then
        echo "Error: File does not exist"
        exit 1
    fi
    # docker needs an absolute path for bind mounts
    path=$(realpath -- "$path")

    echo "This will DELETE all current contents of Volume $volume and replace them with the contents of $path."
    echo "Do you want to continue? (y/n)"
    read -r answer
    if [ "$answer" != "y" ]; then
        echo "Aborted."
        exit 1
    fi

    echo "Restoring backup to Volume $volume..."
    # verify the archive before deleting anything, then empty the volume (including hidden files) and extract
    if ! docker run --rm --mount "source=$volume,target=/mnt/restoreme" -v "$path:/mnt/backup.tar.gz:ro" busybox sh -c "tar tzf /mnt/backup.tar.gz > /dev/null && cd /mnt/restoreme && find . -mindepth 1 -delete && tar x --overwrite -zf /mnt/backup.tar.gz"; then
        echo "Error: Restore failed."
        exit 1
    fi
    echo "Restore done."
fi
